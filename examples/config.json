    "pipeline_bronze_control_config" : [
        {
            "source_table": "customer",
            "source_path_dev": "@RAW.PUBLIC.LANDING/customers/",
            "load_strategy":"full",
            "reader_format": "CSV",
            "table_properties":["ENABLE_SCHEMA_EVOLUTION=TRUE","CLUSTER BY _INGESTED_AT","DEFAULT_DDL_COLLATION='fr-ai'"],
            "bronze_database_dev": "ANALYTICS",
            "bronze_schema": "BRONZE",
            "bronze_table": "CUSTOMER"
        },
        {
            "source_table": "customer",
            "source_path_dev": "@RAW.PUBLIC.LANDING/customersjs/",
            "reader_format": "JSON",
